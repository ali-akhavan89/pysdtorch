{UTF-8}
tsp2=
	5
	~	Month [1,10]
	~		|

NSeed=
	1
	~	dmnl
	~		|

PN1=
	Max(0,Min(2,RANDOM PINK NOISE(1,sp1, tsp1, NSeed )))
	~	dmnl
	~	Auto-correlated noise impacting first agent's feature rate
	|

PN2=
	Max(0,Min(2,RANDOM PINK NOISE(1,sp2, tsp2, NSeed )))
	~	dmnl
	~	Auto-correlated noise impacting second agent's feature rate
	|

sp2=0
	~	dmnl [0,0.2]
	~		|

tsp1=
	5
	~	Month [1,10]
	~		|

SM1=0
	~	dmnl [0,0.2]
	~	Measurement noise standard deviation
	|

MN1 Data=
	N1*RANDOM NORMAL( 0, 2, 1, SM1, NSeed)
	~	Units
	~	Measured first agent feature
	~	:SUPPLEMENTARY 
	|

MN2 Data=
	N2*RANDOM NORMAL( 0, 2, 1, SM2, NSeed)
	~	Units
	~		~	:SUPPLEMENTARY 
	|

SM2=0
	~	dmnl [0,0.2]
	~	Measurement noise standard deviation
	|

sp1=0
	~	dmnl [0,0.2]
	~		|

a12=
	0.1
	~	1/Month [0,0.1]
	~	How much each unit of actor 2 property crowds out actor 1 property.
	|

a21=
	-0.05
	~	1/Month [-0.1,0]
	~	How much each unit of actor 1 property crowds out actor 2 property.
	|

dN1=
	N1*(r1-(K1*N1+a12*N2)/N)*PN1
	~	Units/Month
	~	Rate of change in actor 1 feature.
	|

dN2=
	N2*(r2-(K2*N2+a21*N1)/N)*PN2
	~	Units/Month
	~	The rate of change in the second actors feature
	|

Init N1=
	0.1
	~	dmnl [0,1]
	~	Initial of actor 1 property as a fraction of total feasible
	|

Init N2=
	0.1
	~	dmnl [0,1]
	~	Initial of actor 2 property as a fraction of total feasible
	|

K1=
	0.01
	~	1/Month [0.01,0.05]
	~	Capacity constraint driven reduction in growth for second species feature.
	|

K2=
	0.03
	~	1/Month [0,0.05]
	~	Capacity constraint driven reduction in growth for second species feature.
	|

N=
	1
	~	Units [0,1]
	~	Scale of features for both actors.
	|

N1= INTEG (
	dN1,
		Init N1*N)
	~	Units
	~	The stock of first actor (species, firm market share, etc)
	|

N2= INTEG (
	dN2,
		Init N2*N)
	~	Units
	~	The stock of the second
		 actor (species, firm market share, etc)
	|

r1=
	0.1
	~	1/Month [0,0.1]
	~	Maximum growth rate for actor 1 property
	|

r2=
	-0.05
	~	1/Month [-0.1,0]
	~	Maximum growth rate for actor 2 property
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 200
	~	Month [50,500]
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 1
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.0625
	~	Month [0,?]
	~	The time step for the simulation.
	|

