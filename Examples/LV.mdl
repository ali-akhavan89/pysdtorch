{UTF-8}
SM1=0.1
	~	dmnl
	~		|

SM2=0.1
	~	dmnl
	~		|

dN2=N2*(r2-(K2*N2+a21*N1)/N)*PN2
	~	Units/Month
	~	The rate of change in the second actors feature
	|

NSeed=10
	~	dmnl
	~		|

dN1=N1*(r1-(K1*N1+a12*N2)/N)*PN1
	~	Units/Month
	~	Rate of change in actor 1 feature.
	|

WN2=1+sp2*sqrt((2-(TIME STEP/tsp2))/(TIME STEP/tsp2))*RANDOM NORMAL(-10, 10, 0, 1, NSeed\
		 )
	~	dmnl
	~		|

dPN1Stock=(WN1-PN1Stock)/tsp1
	~	1/Month
	~		|

dPN2Stock=(WN2-PN2Stock)/tsp2
	~	1/Month
	~		|

sp2=0.1
	~	dmnl
	~		|

tsp1=5
	~	Month
	~		|

sp1=0.1
	~	dmnl
	~		|

WN1=1+sp1*sqrt((2-(TIME STEP/tsp1))/(TIME STEP/tsp1))*RANDOM NORMAL(-10, 10, 0, 1, NSeed\
		 )
	~	dmnl
	~		|

PN1=Max(0,Min(2,PN1Stock))
	~	dmnl
	~		|

tsp2=5
	~	Month
	~		|

PN2=Max(0,Min(2,PN2Stock))
	~	dmnl
	~		|

PN2Stock= INTEG (dPN2Stock,
		1)
	~	dmnl
	~		|

PN1Stock= INTEG (dPN1Stock,
		1)
	~	dmnl
	~		|

MN1=N1*RANDOM NORMAL( 0, 2, 1, SM1, NSeed)
	~	Units
	~	Measured first agent feature
	~	:SUPPLEMENTARY 
	|

MN2=N2*RANDOM NORMAL( 0, 2, 1, SM2, NSeed)
	~	Units
	~		~	:SUPPLEMENTARY 
	|

a12=
	0.1
	~	1/Month [0,0.1]
	~	How much each unit of actor 2 property crowds out actor 1 property.
	|

a21=
	-0.05
	~	1/Month [-0.1,0]
	~	How much each unit of actor 1 property crowds out actor 2 property.
	|

Init N1=
	0.1
	~	dmnl [0,1]
	~	Initial of actor 1 property as a fraction of total feasible
	|

Init N2=
	0.1
	~	dmnl [0,1]
	~	Initial of actor 2 property as a fraction of total feasible
	|

K1=
	0.01
	~	1/Month [0.01,0.05]
	~	Capacity constraint driven reduction in growth for second species feature.
	|

K2=
	0.03
	~	1/Month [0,0.05]
	~	Capacity constraint driven reduction in growth for second species feature.
	|

N=
	1
	~	Units [0,1]
	~	Scale of features for both actors.
	|

N1= INTEG (
	dN1,
		Init N1*N)
	~	Units
	~	The stock of first actor (species, firm market share, etc)
	|

N2= INTEG (
	dN2,
		Init N2*N)
	~	Units
	~	The stock of the second
		 actor (species, firm market share, etc)
	|

r1=
	0.1
	~	1/Month [0,0.1]
	~	Maximum growth rate for actor 1 property
	|

r2=
	-0.05
	~	1/Month [-0.1,0]
	~	Maximum growth rate for actor 2 property
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 200
	~	Month [50,500]
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 1
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.0625
	~	Month [0,?]
	~	The time step for the simulation.
	|

